<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>INGCO Store</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getDatabase, ref, push, onValue, remove } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-database.js";

        const firebaseConfig = {
            apiKey: "AIzaSyB7mIOGY-bdNLVTzflXOl3t9bDLaQiLbKs",
            authDomain: "ingco-store.firebaseapp.com",
            databaseURL: "https://ingco-store-default-rtdb.firebaseio.com",
            projectId: "ingco-store",
            storageBucket: "ingco-store.firebasestorage.app",
            messagingSenderId: "286206400336",
            appId: "1:286206400336:web:f39161a02e514512d3fe55"
        };

        const app = initializeApp(firebaseConfig);
        const db = getDatabase(app);
        const botToken = "8546147813:AAHiZp8z236sJAwfItgM4yUFyijaMBHBP6U";
        const adminChatId = "5667696089";

        let cart = [];

        // --- TAVAR QO'SHISH ---
        window.addProduct = function() {
            const name = document.getElementById('p_name').value;
            const oldP = document.getElementById('p_old_price').value;
            const newP = document.getElementById('p_new_price').value;
            const img = document.getElementById('p_img_url').value;

            if(name && newP && img) {
                push(ref(db, 'products'), { name, oldP, newP, img });
                alert("Tavar qo'shildi!");
                document.getElementById('add-form').reset();
            }
        };

        // --- TAVARNI O'CHIRISH (Admin uchun) ---
        window.deleteProduct = function(id) {
            if(confirm("Ushbu tavarni o'chirmoqchimisiz?")) {
                remove(ref(db, `products/${id}`));
            }
        };

        // --- TAVARLARNI CHIQARISH ---
        onValue(ref(db, 'products'), (snapshot) => {
            const list = document.getElementById('product-list');
            list.innerHTML = '';
            const data = snapshot.val();
            for (let id in data) {
                const isAdmin = window.currentUserId == adminChatId;
                list.innerHTML += `
                    <div class="product-card">
                        ${isAdmin ? `<i class="fa fa-trash delete-icon" onclick="deleteProduct('${id}')"></i>` : ''}
                        <img src="${data[id].img}" alt="img">
                        <p><b>${data[id].name}</b></p>
                        <p class="old-price">${data[id].oldP} so'm</p>
                        <p class="new-price">${data[id].newP} so'm</p>
                        <button class="btn-main" onclick="addToCart('${data[id].name}', '${data[id].newP}')">🛒 Savatga</button>
                    </div>`;
            }
        });

        // --- SAVAT MANTIQI ---
        window.addToCart = function(name, price) {
            cart.push({name, price});
            document.getElementById('cart-count').innerText = cart.length;
            Telegram.WebApp.HapticFeedback.notificationOccurred('success');
        };

        // --- BUYURTMA YUBORISH ---
        window.sendOrder = function() {
            const region = document.getElementById('region_select').value;
            const phone = document.getElementById('user_phone').value;
            
            if(region && phone && cart.length > 0) {
                let itemsText = cart.map(i => ` - ${i.name} (${i.price} so'm)`).join('\n');
                let total = cart.reduce((a, b) => a + parseInt(b.price), 0);

                const message = `🔔 YANGI BUYURTMA!\n\n👤 Mijoz ID: ${window.currentUserId}\n📍 Viloyat: ${region}\n📞 Tel: ${phone}\n\n📦 Tavarlar:\n${itemsText}\n\n💰 Jami: ${total} so'm`;
                
                fetch(`https://api.telegram.org/bot${botToken}/sendMessage?chat_id=${adminChatId}&text=${encodeURIComponent(message)}`)
                .then(() => {
                    push(ref(db, 'orders'), { user_id: window.currentUserId, items: cart, total, region, phone });
                    cart = [];
                    document.getElementById('cart-count').innerText = '0';
                    Telegram.WebApp.showAlert("Buyurtma yuborildi! Botimiz sizga xabar berdi.");
                    showPage('home', document.getElementById('nav-home'));
                });
            } else { alert("Savat bo'sh yoki ma'lumotlar kam!"); }
        };
    </script>

    <style>
        :root { --tg-theme-button-color: #f39c12; }
        body { font-family: sans-serif; margin: 0; background: #f9f9f9; padding-bottom: 80px; }
        .page { display: none; padding: 15px; }
        .active { display: block; }
        .catalog-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .product-card { background: #fff; padding: 10px; border-radius: 12px; position: relative; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .product-card img { width: 100%; height: 110px; object-fit: contain; }
        .delete-icon { position: absolute; top: 5px; right: 5px; color: red; background: #fff; padding: 5px; border-radius: 50%; border: 1px solid #eee; cursor: pointer; }
        .old-price { text-decoration: line-through; color: #999; font-size: 11px; }
        .new-price { font-weight: bold; color: #d35400; font-size: 14px; }
        .nav-bar { position: fixed; bottom: 0; width: 100%; background: #fff; display: flex; padding: 10px 0; border-top: 1px solid #ddd; }
        .nav-item { flex: 1; text-align: center; font-size: 10px; color: #888; position: relative; }
        .active-nav { color: var(--tg-theme-button-color); }
        #cart-count { position: absolute; top: -5px; right: 20%; background: red; color: #fff; padding: 2px 6px; border-radius: 50%; font-size: 10px; }
        input, select { width: 100%; padding: 12px; margin: 5px 0; border-radius: 8px; border: 1px solid #ddd; box-sizing: border-box; }
        .btn-main { background: var(--tg-theme-button-color); color: #fff; border: none; padding: 10px; width: 100%; border-radius: 8px; font-weight: bold; margin-top: 5px; }
    </style>
</head>
<body>

<div id="home" class="page active">
    <h3>🛠 INGCO Katalog</h3>
    <div class="catalog-grid" id="product-list"></div>
</div>

<div id="cart" class="page">
    <h3>🛒 Buyurtmani rasmiylashtirish</h3>
    <select id="region_select">
        <option value="">Viloyatni tanlang</option>
        <option value="Toshkent">Toshkent</option>
        <option value="Andijon">Andijon</option>
        <option value="Farg'ona">Farg'ona</option>
        <option value="Namangan">Namangan</option>
        <option value="Buxoro">Buxoro</option>
        <option value="Samarqand">Samarqand</option>
    </select>
    <input type="tel" id="user_phone" placeholder="901234567">
    <button class="btn-main" onclick="sendOrder()">Tasdiqlash</button>
</div>

<div id="profile" class="page">
    <div id="admin-panel" style="display: none;">
        <h3 style="color: #e67e22;">⚙️ Admin Panel</h3>
        <form id="add-form">
            <input type="text" id="p_img_url" placeholder="Rasm URL (havolasi)">
            <input type="text" id="p_name" placeholder="Mahsulot nomi">
            <input type="number" id="p_old_price" placeholder="Eski narxi">
            <input type="number" id="p_new_price" placeholder="Yangi narxi">
            <button type="button" class="btn-main" onclick="addProduct()">Bazaga qo'shish</button>
        </form>
    </div>
    <p>Sizning ID: <b id="u_id"></b></p>
</div>

<div class="nav-bar">
    <div class="nav-item active-nav" id="nav-home" onclick="showPage('home', this)"><i class="fa fa-house"></i><br>UY</div>
    <div class="nav-item" onclick="showPage('cart', this)">
        <span id="cart-count">0</span>
        <i class="fa fa-cart-shopping"></i><br>SAVAT
    </div>
    <div class="nav-item" id="admin-tab" onclick="showPage('profile', this)"><i class="fa fa-user"></i><br>PROFIL</div>
</div>

<script>
    let tg = window.Telegram.WebApp;
    tg.expand();
    const adminChatId = "5667696089";
    window.currentUserId = tg.initDataUnsafe.user ? tg.initDataUnsafe.user.id : "TestMode";
    
    document.getElementById('u_id').innerText = window.currentUserId;
    if(window.currentUserId == adminChatId) {
        document.getElementById('admin-panel').style.display = 'block';
        document.getElementById('admin-tab').style.color = 'orange';
    }

    window.showPage = function(pId, el) {
        document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
        document.getElementById(pId).classList.add('active');
        document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active-nav'));
        el.classList.add('active-nav');
    }
</script>
</body>
</html>
